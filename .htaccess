# Apache / LiteSpeed configuration (Linux hosting).
# ASCII-only on purpose: FTP clients in "ASCII mode" corrupt UTF-8 bytes.
# On Windows/IIS this file is ignored; web.config is used instead.

# 1) Default document
DirectoryIndex index.php index.html

# 2) Disable directory listing
#    (IndexIgnore instead of "Options -Indexes", which causes 500 on some hosts)
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# 3) Block direct access to the database and other sensitive files
<FilesMatch "\.(db|db-journal|sqlite|log|md|sh|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 4) Block direct access to internal folders and to the temp folder
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(inc|views|tmp|docs|release)/ - [F,L]
</IfModule>

# 5) Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6) Correct encoding for Persian text
<IfModule mod_mime.c>
  AddDefaultCharset UTF-8
</IfModule>
