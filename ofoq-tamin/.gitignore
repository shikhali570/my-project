# پایگاه داده محلی (در زمان اجرا ساخته می‌شود)
*.db
*.db-journal
*.sqlite
# فایل‌های موقت و سیستمی
.DS_Store
Thumbs.db
*.log
# پوشه موقت (فایل‌های نشست در زمان اجرا)
tmp/*
!tmp/.htaccess
!tmp/web.config
!tmp/.gitkeep_note.txt

# تصاویر آپلودی کالاها (در زمان اجرا ساخته می‌شوند و در گیت نیستند)
uploads/*
!uploads/.htaccess
!uploads/web.config
