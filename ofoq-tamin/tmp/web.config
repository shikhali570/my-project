<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deny direct HTTP access to this folder on IIS.
  It only holds PHP session files and temporary data.
  If your host locks requestFiltering, requests to /tmp/ answer 500.19 instead
  of 403; that is harmless for the application, and you can simply delete this
  file. The root web.config stays untouched.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
        <hiddenSegments>
          <add segment="sessions" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
