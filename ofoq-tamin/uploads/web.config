<?xml version="1.0" encoding="UTF-8"?>
<!--
  Product images uploaded from the admin panel (uploads/products).
  Only static image files are served from this folder. Script files are
  refused here, so an uploaded file can never run as PHP, even if it is renamed.
  Keep this file ASCII-only and upload it in Binary mode.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <remove fileExtension=".php" />
          <add fileExtension=".php" allowed="false" />
          <remove fileExtension=".phtml" />
          <add fileExtension=".phtml" allowed="false" />
          <remove fileExtension=".phar" />
          <add fileExtension=".phar" allowed="false" />
          <remove fileExtension=".asp" />
          <add fileExtension=".asp" allowed="false" />
          <remove fileExtension=".aspx" />
          <add fileExtension=".aspx" allowed="false" />
          <remove fileExtension=".cgi" />
          <add fileExtension=".cgi" allowed="false" />
          <remove fileExtension=".pl" />
          <add fileExtension=".pl" allowed="false" />
          <remove fileExtension=".sh" />
          <add fileExtension=".sh" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
