<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the Ofogh Taamin (ofoq-tamin) site.
  Same structure as the Mohusyn.ir configuration, adapted to this application.

  Notes
  1. Keep this file ASCII-only and upload it in Binary mode. An FTP transfer in
     ASCII mode can corrupt UTF-8 bytes, and IIS then answers every request with
     HTTP 500.19.
  2. Requires the IIS FastCGI feature, the URL Rewrite module, and the PHP
     FastCGI application registered on the server (same as the Mohusyn site).
     If PHP is installed somewhere other than C:\php, change scriptProcessor.
  3. The application routes every page through index.php?page=..., so no
     front-controller rewrite rule is needed.
  4. maxAllowedContentLength must stay above post_max_size in .user.ini (12M).
-->
<configuration>
  <system.webServer>

    <!-- PHP through FastCGI. The remove element prevents a duplicate-key error
         when the same handler is inherited from the server configuration. -->
    <handlers>
      <remove name="PHP_via_FastCGI" />
      <add name="PHP_via_FastCGI"
           path="*.php"
           verb="GET,HEAD,POST"
           modules="FastCgiModule"
           scriptProcessor="C:\php\php-cgi.exe"
           resourceType="Unspecified" />
    </handlers>

    <!-- Default documents -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
        <add value="index.htm" />
      </files>
    </defaultDocument>

    <!-- Disable directory listing -->
    <directoryBrowse enabled="false" />

    <!-- URL Rewrite: block direct access to internal folders with 403 -->
    <rewrite>
      <rules>
        <rule name="BlockInternalFolders" stopProcessing="true">
          <match url="^(inc|views|tmp|docs|release|iis|\.git)(/|$)" />
          <action type="CustomResponse"
                  statusCode="403"
                  statusReason="Forbidden"
                  statusDescription="Forbidden" />
        </rule>
      </rules>
    </rewrite>

    <!-- Error pages: detailed only for local requests; the application's own
         error pages are passed through to visitors -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <!-- Request filtering -->
    <security>
      <requestFiltering>
        <!-- 16 MB. Product image uploads (at most 5 MB each, see config.php) need this headroom. -->
        <requestLimits maxAllowedContentLength="16777216" />

        <!-- Database files, logs, and configuration files are never served -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".db-journal" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>

        <hiddenSegments>
          <add segment="inc" />
          <add segment="views" />
          <add segment="tmp" />
          <add segment="docs" />
          <add segment="iis" />
          <add segment="release" />
          <add segment=".git" />
          <add segment=".htaccess" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- MIME types for fonts and WebP images -->
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- Compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
