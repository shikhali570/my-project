<?xml version="1.0" encoding="UTF-8"?>
<!--
  پارس سازه و آفیس | تنظیمات IIS (هاست ویندوز، Plesk)
  این فایل باید در ریشه سایت، کنار index.php قرار بگیرد.
  اگر هاست شما لینوکس/آپاچی است، این فایل بی‌اثر است و باید از htaccess استفاده کنید.

  توجه: در این فایل عمداً هیچ نگاشت Handler برای PHP تعریف نشده است تا با
  تنظیمات سراسری هاست (FastCGI) تعارضی پیش نیاید. PHP روی هاست باید از پنل
  هاست فعال و نسخه آن ۷.۴ یا بالاتر انتخاب شده باشد.
-->
<configuration>
  <system.webServer>

    <!-- ۱) صفحه پیش‌فرض: index.php -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- ۲) غیرفعال کردن فهرست شدن فایل‌های پوشه -->
    <directoryBrowse enabled="false" />

    <!-- ۳) نمایش پیام واقعی خطای PHP به‌جای صفحه ۵۰۰ عمومی.
         برای عیب‌یابی لازم است؛ پس از رفع مشکل مقدار errorMode را
         به DetailedLocalOnly برگردانید. -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <!-- ۴) مسدود کردن دسترسی مستقیم به فایل‌های حساس -->
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".dbjournal" allowed="false" />
          <add fileExtension=".journal" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="inc" />
          <add segment="views" />
          <add segment=".git" />
          <add segment=".gitignore" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ۵) هدرهای امنیتی -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
