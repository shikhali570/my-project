<?xml version="1.0" encoding="UTF-8"?>
<!--
  پارس سازه و آفیس | تنظیمات IIS (هاست ویندوز، Plesk، WebHostPanel)
  این فایل باید در ریشه سایت، کنار index.php قرار بگیرد.

  این نسخه «حداقلی» است و فقط شامل تنظیماتی است که روی تقریباً همه هاست‌های
  اشتراکی مجاز هستند، تا خودش باعث خطای ۵۰۰ (نوع ۵۰۰.۱۹؛ قفل‌بودن بخش‌های
  config در سرور) نشود.

  اگر روی هاست شما باز هم خطای ۵۰۰ داد، نام این فایل را به web.config.off
  تغییر دهید؛ برنامه بدون این فایل هم کامل کار می‌کند (مسیریابی برنامه از
  طریق index.php?page=... انجام می‌شود و نیازی به rewrite ندارد).

  بخش‌های پیشرفته (نمایش متن خطای PHP، مسدودسازی parssaze.db و پوشه‌های
  inc و views، هدرهای امنیتی) به صورت توضیح در انتهای همین فایل آمده‌اند؛
  اگر هاست شما اجازه داد، آن‌ها را از حالت توضیح خارج کنید.
-->
<configuration>
  <system.webServer>

    <!-- ۱) صفحه پیش‌فرض: index.php -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- ۲) غیرفعال کردن فهرست شدن فایل‌های پوشه -->
    <directoryBrowse enabled="false" />

<!--
    ▓▓ بخش‌های اختیاری ▓▓
    این بخش‌ها روی بعضی هاست‌ها قفل هستند و استفاده از آن‌ها خطای ۵۰۰.۱۹
    می‌دهد. یک‌جا یک بخش را فعال کنید، صفحه را تست کنید، بعد سراغ بخش بعدی بروید.

    (۳) نمایش متن واقعی خطای PHP به‌جای صفحه ۵۰۰ عمومی (برای عیب‌یابی)
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    (۴) مسدودکردن دسترسی مستقیم به پایگاه داده و فایل‌های حساس
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".journal" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="inc" />
          <add segment="views" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    (۵) هدرهای امنیتی
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    نکته: هیچ نگاشت Handler برای PHP در این فایل تعریف نشده است. تعریف دستی
    Handler با تنظیمات سراسری هاست تعارض می‌کند و خطای ۵۰۰.۱۹ می‌دهد؛
    فعال‌سازی PHP باید از پنل هاست انجام شود.
-->

  </system.webServer>
</configuration>
