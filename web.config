<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for this PHP application (Windows hosting / Plesk / WebHostPanel).
  Place this file in the site root, next to index.php.

  IMPORTANT - THIS FILE IS INTENTIONALLY ASCII-ONLY AND MINIMAL:
  1. ASCII-only, because many FTP clients corrupt UTF-8 bytes when a file is
     transferred in "ASCII mode". A single corrupted byte inside a comment makes
     the XML invalid and IIS answers every request with HTTP 500.19.
  2. Minimal, because shared hosts lock some configuration sections. Using a
     locked section also produces HTTP 500.19 ("This configuration section
     cannot be used at this path").

  Only two sections are active below (defaultDocument + directoryBrowse); both
  are unlocked by default on IIS 7 / 7.5 / 8 / 10 and on Plesk for Windows.

  NO PHP handler mapping is declared here on purpose. Registering PHP through a
  per-site web.config conflicts with the host's global FastCGI settings and is
  the most common cause of a broken site (500.19 or 500.0). PHP must be enabled
  from the hosting control panel ("Select PHP version" / "PHP Settings").

  If the site still returns 500.19 after uploading this file, rename it to
  web.config.off and reload. The application works without it: routing is done
  with index.php?page=... and no URL rewrite rule is required.

  Full Persian troubleshooting guide: docs/IIS-SETUP.md
  Online diagnostics page:            check.php
-->
<configuration>
  <system.webServer>

    <!-- 1) Default document: index.php -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- 2) Disable directory listing -->
    <directoryBrowse enabled="false" />

<!--
    ================= OPTIONAL SECTIONS (commented out) =================
    Enable ONE section at a time, reload the site, and only then continue.
    If a section is locked by your host you will get HTTP 500.19; just put
    the comment markers back.

    (3) Show the real PHP error text instead of the generic 500 page.
        USE ONLY WHILE DEBUGGING, then comment it out again.
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    (4) Block direct download of the SQLite database and sensitive files.
        requestFiltering is unlocked on most hosts, so this one is usually safe.
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".journal" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="inc" />
          <add segment="views" />
          <add segment="tmp" />
          <add segment="docs" />
          <add segment="release" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    (5) Security headers.
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    (6) MIME types for fonts, in case the host runs an old IIS (7.5) that has
        no mapping for woff2 and answers 404.3. Only needed if you host font
        files locally instead of using a CDN.
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
    </staticContent>

    (7) DO NOT enable unless your host explicitly allows per-site handlers.
        A wrong handler path breaks the whole site with 500.0 / 500.19.
        On Plesk for Windows use the panel instead: Websites & Domains ->
        PHP Settings -> select the PHP version.
    <handlers>
      <add name="PHP-App" path="*.php" verb="GET,HEAD,POST"
           modules="FastCgiModule"
           scriptProcessor="C:\Program Files\PHP\v8.2\php-cgi.exe"
           resourceType="Either" />
    </handlers>
-->

  </system.webServer>
</configuration>
